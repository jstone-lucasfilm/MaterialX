<?xml version="1.0"?>
<materialx version="1.39" colorspace="acescg">

  <!-- LamaConductor with a Gulbrandsen edge color -->
  <LamaConductor name="LamaConductorGulbrandsen" type="BSDF">
    <input name="reflectivity" type="color3" value="0.9450, 0.7772, 0.3737" />
    <input name="edgeColor" type="color3" value="0.9979, 0.9813, 0.7523" />
    <input name="edgeColorMode" type="integer" value="1" />
    <input name="roughness" type="float" value="0.25" />
  </LamaConductor>
  <surface name="LamaConductorGulbrandsenSurface" type="surfaceshader">
    <input name="bsdf" type="BSDF" nodename="LamaConductorGulbrandsen" />
  </surface>
  <surfacematerial name="LamaConductorGulbrandsenTest" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="LamaConductorGulbrandsenSurface" />
  </surfacematerial>

  <!-- LamaConductor with a Belcour edge color and rotated anisotropy -->
  <LamaConductor name="LamaConductorBelcour" type="BSDF">
    <input name="reflectivity" type="color3" value="0.95, 0.64, 0.54" />
    <input name="edgeColor" type="color3" value="0.9, 0.6, 0.4" />
    <input name="edgeColorMode" type="integer" value="0" />
    <input name="roughness" type="float" value="0.25" />
    <input name="anisotropy" type="float" value="0.6" />
    <input name="anisotropyRotation" type="float" value="0.125" />
  </LamaConductor>
  <surface name="LamaConductorBelcourSurface" type="surfaceshader">
    <input name="bsdf" type="BSDF" nodename="LamaConductorBelcour" />
  </surface>
  <surfacematerial name="LamaConductorBelcourTest" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="LamaConductorBelcourSurface" />
  </surfacematerial>

</materialx>
